# Shared Solana settings
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# Base58 secret key (or JSON array) for live mode.
SOLANA_PRIVATE_KEY=

# Swap defaults: tiny USDC -> SOL (avoids new-token-account rent since SOL is the output)
INPUT_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
OUTPUT_MINT=So11111111111111111111111111111111111111112
# 100000 atomic units = 0.1 USDC (6 decimals), ~$0.10 (small live test size)
INPUT_AMOUNT=100000
EXPLORER_URL=https://orb.helius.dev/tx

# Jupiter Ultra API
JUPITER_ULTRA_BASE_URL=https://lite-api.jup.ag/ultra/v1
# Optional for both Ultra and Swap API V2 (src/03-jupiter-swap-v2.ts); raises the rate limit
JUPITER_API_KEY=

# Jupiter Swap API V2 (optional override)
JUPITER_SWAP_V2_BASE_URL=https://api.jup.ag/swap/v2

# DFlow API defaults
DFLOW_TRADE_API_URL=https://dev-quote-api.dflow.net
# Optional for production usage
DFLOW_API_KEY=

# OKX-shaped adapter swap (src/04-okx-swap.ts)
# Kept for source-shape parity; not used by DFlow. 501 = Solana in OKX's chain index.
OKX_CHAIN_ID=501
# Percentage, not bps (e.g. 0.5 means 0.5%)
OKX_SLIPPAGE_PERCENT=0.5
